# Create a bot with BotFather. Only the owner's Telegram updates are accepted.
ROUTER_FRONTENDS__TG__OPTIONS__TOKEN=123456:replace-with-your-bot-token
ROUTER_FRONTENDS__TG__OWNER=123456789
# Generate two independent secrets, e.g. openssl rand -hex 32.
ROUTER_API__TOKEN=replace-with-an-injection-secret
ROUTER_MCP__TOKEN=replace-with-a-different-mcp-secret
# Optional model provider credentials are inherited by pi.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
